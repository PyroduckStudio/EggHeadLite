.setup-header { padding-top: 24px; padding-bottom: 20px; }
.setup-title { font-size: 27px; -unity-font-style: bold; }
.setup-step { margin-bottom: 8px; font-size: 13px; white-space: normal; }
.setup-note { font-size: 12px; white-space: normal; opacity: 0.8; margin-top: 10px; }
.setup-controls { flex-direction: row; align-items: center; margin-top: 12px; }
.setup-controls .secondary-button { flex-grow: 0; width: 80px; }
.setup-controls .status { margin-left: 12px; }
.setup-hidden { display: none; }
.discount-ribbon.setup-sale { display: flex; }
.setup-footer { margin-top: 8px; }
.setup-page .button-row { flex-wrap: wrap; }
.setup-page .button-row Button { min-width: 150px; margin-bottom: 6px; }
